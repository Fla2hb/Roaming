# Copy this file to .env and fill in your keys.
# Keys are only used in the browser build — never commit .env to git.

# Hiking Project API (REI) — free key at https://www.hikingproject.com/data
VITE_HIKING_PROJECT_KEY=YOUR_KEY_HERE

# Mapbox — free token at https://account.mapbox.com
VITE_MAPBOX_TOKEN=YOUR_TOKEN_HERE
